{
  "name": "igreja",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "build": "npm run build:css && npm run build:leitor && npm run build:membro",
    "build:leitor": "npm --prefix leitor-qrcode ci --include=dev && npm --prefix leitor-qrcode run build:web",
    "build:membro": "npm --prefix membro-app ci --include=dev && npm --prefix membro-app run build:web",
    "build:css": "sass css/index.scss:css/index.css css/portal.scss:css/portal.css admin/css/admin.scss:admin/css/admin.css --style=compressed --no-source-map",
    "build:css:portal": "sass css/portal.scss css/portal.css --style=compressed --no-source-map",
    "build:css:admin": "sass admin/css/admin.scss admin/css/admin.css --style=compressed --no-source-map",
    "watch:css": "sass --watch css/index.scss:css/index.css css/portal.scss:css/portal.css admin/css/admin.scss:admin/css/admin.css --style=compressed --no-source-map",
    "prestart": "node scripts/migrate.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node database/seed.js",
    "criar-admin": "node scripts/criarAdministrador.js",
    "regerar-qrcodes": "node scripts/regerarQRCodes.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "html5-qrcode": "^2.3.8",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "resend": "^6.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sass": "^1.107.1"
  }
}

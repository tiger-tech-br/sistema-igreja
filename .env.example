PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=troque_por_um_segredo_grande
# No Railway, deixe vazio para usar automaticamente 1 proxy confiável.
# Fora dele, use 0 sem proxy ou informe a quantidade exata de proxies.
TRUST_PROXY_HOPS=

# Obrigatórios para habilitar novos cadastros e identificar o controlador.
PRIVACY_CONTROLLER="Nome completo ou razão social da igreja"
PRIVACY_EMAIL=privacidade@igreja.org.br

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha
DB_NAME=igreja

LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

RESEND_API_KEY=sua_chave_resend
EMAIL_FROM="Tiger Tech <suporte@tigertech.dev.br>"

# Use apenas durante npm run criar-admin e remova a senha depois.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@igreja.org.br
ADMIN_PASSWORD=

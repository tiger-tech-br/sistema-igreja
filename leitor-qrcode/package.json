{
  "name": "igreja-leitor-qrcode",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Leitor de presenças exclusivo para administradores da igreja",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "sync:android": "npm run build:web && cap sync android",
    "open:android": "cap open android",
    "build:apk": "node scripts/build-android.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "html5-qrcode": "^2.3.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.2.2"
  },
  "engines": { "node": ">=22" }
}
